                            <Height>400</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>450</Width>
                            <Height>800</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon-24.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon-24.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
